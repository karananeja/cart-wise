# Copy to apps/api/.env (git-ignored). The API reads it when it starts; restart `pnpm dev` after changes.
# Values already set in the shell win over this file.

# Razorpay — TEST MODE ONLY (F-014, ADR-005). Live keys (rzp_live_…) are refused.
# Dashboard → Account & Settings → API Keys, with the Dashboard in Test Mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Optional: webhooks need a public URL (e.g. a tunnel) pointing at /api/payments/razorpay/webhook.
# Subscribe to payment.authorized and payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Optional: a No Cost EMI offer created in the Dashboard (Offers), attached to every Razorpay order.
RAZORPAY_NO_COST_EMI_OFFER_ID=

# Optional: demo operator password for the Store Simulation Console (default: demo-operator).
SIM_OPERATOR_PASSWORD=

# Optional: email one-time codes through the MSG91 Email API (F-016, ADR-007). Without all three of
# MSG91_AUTH_KEY, MSG91_TEMPLATE_ID and MSG91_FROM_EMAIL the codes are shown on screen as a labelled demo.
# MSG91 panel: Email → add and verify your domain → create a template using the variables
#   otp, purpose, minutes, store   (e.g. "Your code is <otp>. Use it to <purpose>. Valid for <minutes> minutes.")
# Auth key: MSG91 → profile → Authkey. The key stays on the server and is never logged.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# A sender on your verified domain, e.g. no-reply@mail.yourdomain.com
MSG91_FROM_EMAIL=
# Optional: sender name (default Cartwise) and domain (default: the part after @ in MSG91_FROM_EMAIL).
MSG91_FROM_NAME=
MSG91_DOMAIN=
# Optional: template for the newsletter welcome email (F-018), with the variables unsubscribe_url, store.
# Left blank, subscribing still works and no welcome email is sent.
MSG91_NEWSLETTER_TEMPLATE_ID=

# Optional: where the shop runs, for links in emails (the newsletter unsubscribe link, F-018).
# Blank means http://localhost:5173.
WEB_BASE_URL=
