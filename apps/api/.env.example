# Copy to apps/api/.env (git-ignored). The API reads it when it starts; restart `pnpm dev` after changes.
# Values already set in the shell win over this file.

# Razorpay — TEST MODE ONLY (F-014, ADR-005). Live keys (rzp_live_…) are refused.
# Dashboard → Account & Settings → API Keys, with the Dashboard in Test Mode.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Optional: webhooks need a public URL (e.g. a tunnel) pointing at /api/payments/razorpay/webhook.
# Subscribe to payment.authorized and payment.captured.
RAZORPAY_WEBHOOK_SECRET=

# Optional: a No Cost EMI offer created in the Dashboard (Offers), attached to every Razorpay order.
RAZORPAY_NO_COST_EMI_OFFER_ID=

# Optional: demo operator password for the Store Simulation Console (default: demo-operator).
SIM_OPERATOR_PASSWORD=
