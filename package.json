{
  "name": "e-commerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @store/api dev\" \"pnpm --filter @store/web dev\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "e2e": "playwright test",
    "db:seed": "pnpm --filter @store/api db:seed",
    "catalog:import": "pnpm --filter @store/api catalog:import"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
